# Puerto del microservicio
PORT=3000

# Base de datos relacional en la nube (PostgreSQL o MySQL)
# Ejemplo Supabase / Neon / Render PostgreSQL:
# DATABASE_URL=postgres://usuario:password@ep-ejemplo.us-east-2.aws.neon.tech/neondb?sslmode=require

# Ejemplo Aiven / Railway MySQL:
# DATABASE_URL=mysql://root:password@containers-us-west-1.railway.app:3306/railway

# O mediante credenciales individuales:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=pokemon_db
